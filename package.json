{
  "name": "fastify-app",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:userfacing": "nodemon server.userfacing.js",
    "dev:onboarding": "nodemon server.onboarding.js",
    "start": "node src/server.js",
    "start:userfacing": "node server.userfacing.js",
    "start:onboarding": "node server.onboarding.js",
    "postinstall": "prisma generate",
    "deploy:userfacing": "gcloud app deploy app.yaml",
    "deploy:onboarding": "gcloud app deploy app.control-desk.yaml",
    "deploy:all": "gcloud app deploy app.yaml app.control-desk.yaml"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@google-cloud/cloud-sql-connector": "^1.8.4",
    "@google-cloud/pubsub": "^5.2.1",
    "@google-cloud/storage": "^7.18.0",
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.0.1",
    "@sinclair/typebox": "^0.34.48",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.0.1"
  }
}
