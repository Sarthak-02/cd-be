{
  "name": "fastify-app",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:userfacing": "nodemon server.userfacing.js",
    "dev:onboarding": "nodemon server.onboarding.js",
    "dev:default": "nodemon server.default.js",
    "start": "node src/server.js",
    "start:userfacing": "node server.userfacing.js",
    "start:onboarding": "node server.onboarding.js",
    "start:default": "node server.default.js",
    "postinstall": "prisma generate",
    "deploy:userfacing": "gcloud app deploy app.yaml",
    "deploy:onboarding": "gcloud app deploy app.control-desk.yaml",
    "deploy:default": "gcloud app deploy app.default.yaml",
    "deploy:all": "gcloud app deploy app.yaml app.control-desk.yaml app.default.yaml",
    "deploy:dispatch": "gcloud app deploy dispatch.yaml",
    "test:load:auth": "k6 run test/load/auth.load.js",
    "test:load:attendance": "k6 run test/load/attendance.load.js",
    "test:load:homework": "k6 run test/load/homework.load.js",
    "test:load:exam": "k6 run test/load/exam.load.js",
    "test:load:examGrade": "k6 run test/load/examGrade.load.js",
    "test:load:notifications": "k6 run test/load/notifications.load.js",
    "test:load:pickup": "k6 run test/load/pickup.load.js",
    "test:load:broadcast": "k6 run test/load/broadcast.load.js",
    "test:load:lessonPlan": "k6 run test/load/lessonPlan.load.js",
    "test:load:masterLessonPlan": "k6 run test/load/masterLessonPlan.load.js",
    "test:load:classPlan": "k6 run test/load/classPlan.load.js",
    "test:load:studentReport": "k6 run test/load/studentReport.load.js",
    "test:load:teacherReport": "k6 run test/load/teacherReport.load.js",
    "test:load:journey": "k6 run test/load/full-journey.load.js",
    "test:smoke": "k6 run -e SCENARIO=smoke test/load/full-journey.load.js",
    "test:stress": "k6 run -e SCENARIO=stress test/load/full-journey.load.js",
    "test:spike": "k6 run -e SCENARIO=spike test/load/full-journey.load.js"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@google-cloud/cloud-sql-connector": "^1.8.4",
    "@google-cloud/pubsub": "^5.2.1",
    "@google-cloud/storage": "^7.18.0",
    "@prisma/adapter-mariadb": "^7.0.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.0.1",
    "@sinclair/typebox": "^0.34.48",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "mysql2": "^3.15.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.0.1"
  }
}
