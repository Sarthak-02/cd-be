# Example Environment Variables for App Engine Deployment
# 
# Copy the relevant variables from your .env file and add them to:
# - app.yaml (for user-facing-backend)
# - app.control-desk.yaml (for control-desk-backend)
#
# Format in app.yaml:
# env_variables:
#   NODE_ENV: "production"
#   DATABASE_URL: "your-value-here"
#   OTHER_VAR: "value"

# Required for both services:
NODE_ENV=production

# Database
DATABASE_URL=your-database-url

# Ports (App Engine will override with PORT env var)
ONBOARDING_PORT=8080
USERFACING_PORT=8080

# JWT/Auth Secrets
JWT_SECRET=your-jwt-secret
COOKIE_SECRET=your-cookie-secret

# Google Cloud Services
GCS_BUCKET_NAME=your-bucket-name
PUBSUB_TOPIC=your-topic-name

# Firebase (if used)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Other API Keys
# Add any other API keys or configuration needed

# Note: For sensitive data, consider using Google Secret Manager instead
# See DEPLOYMENT.md for Secret Manager setup instructions
