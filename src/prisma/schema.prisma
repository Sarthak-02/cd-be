generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
  Other
}

enum StudentStatus {
  active
  inactive
  passed_out
}

enum TeacherStatus {
  active
  inactive
}

enum AttendanceSessionStatus {
  DRAFT
  NOTIFYING
  SUBMITTED
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CampusSession {
  MORNING
  EVENING
  FULL_DAY
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  APP
}

enum NotificationStatus {
  PENDING // created, not processed yet
  QUEUED // pushed to queue successfully
  RETRYING //Retrying 
  SENT // delivered successfully
  FAILED // permanently failed after retries
}

enum BroadcastStatus {
  DRAFT
  NOTIFYING
  SUBMITTED
}

enum TargetType {
  CAMPUS
  CLASS
  SECTION
  STUDENT
  TEACHER
  GROUP
}

enum NotificationSourceType {
  ATTENDANCE
  BROADCAST
  HOMEWORK
  EXAM
  SYSTEM
  PTM
}

enum PtmSlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
}

enum PtmBookingStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum NotificationRecipientType {
  STUDENT
  PARENT
  TEACHER
  ALL
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum PickupRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum PickupSource {
  AUTHORIZED_PERSON
  ONE_TIME_REQUEST
  MANUAL
}

enum AdmissionStatus {
  pending
  approved
  rejected
  enrolled
}

enum LessonPlanStatus {
  PLANNED
  COMPLETED
  SKIPPED
  PARTIALLY_COMPLETED
}

enum ClassPlanTopicStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TopicAssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum EndUserRole {
  STUDENT
  TEACHER
  ADMIN
  PARENT
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

model User {
  userid   String  @id
  username String
  password String
  isadmin  Boolean @default(false)

  site_permissions Json?
  page_permissions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EndUser {
  id             String   @id @default(uuid())
  userid         String   @unique
  username       String   @unique
  passwordHash   String?  // bcrypt / argon2
  authProvider   AuthProvider @default(LOCAL)

  role           EndUserRole // STUDENT | TEACHER | ADMIN | PARENT
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  tokenVersion   Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model School {
  school_id      String  @id
  school_name    String
  extras         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses Campus[]
}

model Campus {
  campus_id   String @id
  campus_name String
  campus_type String

  school_id String
  school    School @relation(fields: [school_id], references: [school_id], onDelete: Cascade)

  extras Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  Class[]
  students Student[]
  teachers Teacher[]
  lessonPlans LessonPlan[]
  classPlans  ClassPlan[]
  campusTierPermissions CampusTierPermission[]
  admissions Admission[]
  studentGroups StudentGroup[]

  @@index([school_id])
}

model Class {
  class_id String @id @default(uuid())

  class_name         String
  class_short_name   String?
  class_description  String?
  class_room_no      String?
  class_teacher_id   String?
  class_has_sections Boolean @default(false)
  class_type         String?
  class_stream       String?
  class_shift        String?
  extras             Json?

  campus_id String
  campus    Campus @relation(fields: [campus_id], references: [campus_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  lessonPlans LessonPlan[]
  classPlans  ClassPlan[]

  @@index([campus_id])
}

model Section {
  section_id         String  @id @default(uuid())
  section_name       String
  section_short_name String?
  section_teacher_id String?
  section_room_no    String?
  extras             Json?

  class_id String
  classRef Class  @relation(fields: [class_id], references: [class_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessions AttendanceSession[]
  students           Student[]
  lessonPlans        LessonPlan[]
  topicProgress      ClassPlanTopicProgress[]

  @@index([class_id])
}

model Student {
  student_id String @id @default(uuid())

  student_admission_no   String          // stored encrypted; uniqueness via admission_no_hash
  admission_no_hash      String?         // HMAC blind index — unique enforced by SQL partial index
  student_roll_no        String?
  student_photo_url      String?
  student_first_name     String          // encrypted
  student_middle_name    String?         // encrypted
  student_last_name      String?         // encrypted
  student_gender         Gender
  student_dob            String          // encrypted; was DateTime, changed to String
  student_current_status StudentStatus

  student_section_id String?
  section    Section? @relation(fields: [student_section_id], references: [section_id], onDelete: SetNull)

  extras Json?

  campus_id String
  campus    Campus @relation(fields: [campus_id], references: [campus_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecords   AttendanceRecord[]
  parents             Parent[]
  homeworkSubmissions HomeworkSubmission[]
  examGrades          ExamGrade[]
  authorizedPickupPersons AuthorizedPickupPerson[]
  pickupRequests          PickupRequest[]
  pickupLogs              PickupLog[]
  groupMemberships        StudentGroupMember[]
  ptmBookings             PtmBooking[]

  @@index([campus_id])
  @@index([student_current_status])
  @@index([student_section_id, student_current_status])
}

model Parent {
  parent_id String @id @default(uuid())

  name          String          // encrypted
  phone         String?         // encrypted; uniqueness via phone_hash
  phone_hash    String?         // HMAC blind index — unique enforced by SQL partial index
  email         String?         // encrypted
  relation_type String? // Father , Mother , Guardian etc

  student_id String
  student    Student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ptmBookings PtmBooking[]

  @@index([phone_hash])
}

model Teacher {
  teacher_id            String        @id @default(uuid())
  teacher_employee_code String                  // encrypted; uniqueness via employee_code_hash
  employee_code_hash    String?                 // HMAC blind index — unique enforced by SQL partial index
  teacher_first_name    String                  // encrypted
  teacher_middle_name   String?                 // encrypted
  teacher_last_name     String                  // encrypted
  teacher_gender        Gender
  teacher_dob           String                  // encrypted; was DateTime, changed to String
  teacher_photo_url     String?
  teacher_email         String                  // encrypted; uniqueness via email_hash
  email_hash            String?                 // HMAC blind index — unique enforced by SQL partial index
  teacher_phone         String?                 // encrypted; uniqueness via phone_hash
  phone_hash            String?                 // HMAC blind index — unique enforced by SQL partial index
  teacher_status        TeacherStatus
  extras                Json?

  campus_id String
  campus    Campus @relation(fields: [campus_id], references: [campus_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessions AttendanceSession[]
  updatedAttendance  AttendanceRecord[]  @relation("AttendanceUpdatedBy")
  homework           Homework[]
  gradedSubmissions  HomeworkSubmission[] @relation("HomeworkGradedBy")
  lessonPlans        LessonPlan[]
  classPlans         ClassPlan[]
  pickupLogs         PickupLog[]
  studentGroups      StudentGroup[]
  ptmSlots           PtmSlot[]

  @@index([campus_id])
}

model AttendanceSession {
  id String @id @default(uuid())

  sectionId String
  teacherId String

  date          DateTime      @db.Date
  campusSession CampusSession @default(FULL_DAY)
  period        String        @default("OVERALL")

  status AttendanceSessionStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  lockedAt    DateTime?

  section Section @relation(fields: [sectionId], references: [section_id])
  teacher Teacher @relation(fields: [teacherId], references: [teacher_id])

  records AttendanceRecord[]

  @@unique([sectionId, date, campusSession, period])
  @@index([sectionId, date])
  @@index([date])
}

model AttendanceRecord {
  id String @id @default(uuid())

  attendanceSessionId String
  studentId           String

  status AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student           Student           @relation(fields: [studentId], references: [student_id])
  updatedByTeacher  Teacher?          @relation("AttendanceUpdatedBy", fields: [updatedBy], references: [teacher_id])

  @@unique([attendanceSessionId, studentId])
  @@index([attendanceSessionId])
  @@index([studentId])
}

model Notification {
  id        String @id @default(uuid())
  dedupeKey String @unique

  // recipient (polymorphic - kept as scalar fields)
  recipientType NotificationRecipientType
  receiverId    String?
  parentId      String?
  senderId      String?

  channel NotificationChannel
  payload Json

  // source (polymorphic - kept as scalar fields)
  sourceType NotificationSourceType
  sourceId   String // attendanceSessionId, broadcastId, etc.

  status     NotificationStatus @default(PENDING)
  retryCount Int                @default(0)
  lastError  String?
  queuedAt   DateTime?
  sentAt     DateTime?
  read       Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, channel])
  @@index([sourceType, sourceId])
  @@index([sourceId, status])
  @@index([receiverId, status])
}

model BroadcastNotification {
  id        String          @id @default(uuid())
  title     String
  message   String
  category  String @default("general")
  createdBy String // teacher/admin
  campusId  String
  status    BroadcastStatus // DRAFT | NOTIFYING | SUBMITTED

  broadcastAttachments BroadcastAttachment[]
  broadcastTargets     BroadcastTarget[]

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
}

model BroadcastAttachment {
  id                      String @id @default(uuid())
  broadcastNotificationId String
  fileUrl                 String
  fileName                String
  fileType                String
  fileSize                Int

  broadcastNotification BroadcastNotification @relation(fields: [broadcastNotificationId], references: [id], onDelete: Cascade)

  @@index([broadcastNotificationId])
}

model BroadcastTarget {
  id                      String     @id @default(uuid())
  broadcastNotificationId String
  targetType              TargetType // CAMPUS | CLASS | SECTION | STUDENT | TEACHER
  targetId                Json?

  broadcastNotification BroadcastNotification @relation(fields: [broadcastNotificationId], references: [id], onDelete: Cascade)

  @@index([broadcastNotificationId])
}

model UserNotification {
  id              String    @id @default(uuid())
  notification_id String
  receiver_id     String
  read_at         DateTime?

  @@unique([notification_id, receiver_id]) // dedupe + idempotency
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   // Can be student_id, teacher_id, or parent_id
  userType  EndUserRole // STUDENT | TEACHER | PARENT
  token     String   @unique // FCM device token
  platform  String?  // ios, android, web
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastUsedAt DateTime @default(now())
  
  @@unique([userId, token])
  @@index([userId])
  @@index([userType])
}

model Subject {
  subject_id   String  @id @default(uuid())
  subject_name String
  subject_code String?
  description  String?
  campus_id    String
  
  extras Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campus_id, subject_code])
  @@index([campus_id])
}

model Homework {
  id          String         @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  subject     String
  createdBy   String // Teacher's ID
  status      HomeworkStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacher     Teacher              @relation(fields: [createdBy], references: [teacher_id])
  attachments HomeworkAttachment[]
  targets     HomeworkTarget[]

  @@index([createdBy])
  @@index([dueDate])
  @@index([status])
}

model HomeworkAttachment {
  id         String @id @default(uuid())
  homeworkId String
  fileUrl    String
  fileName   String
  fileType   String
  fileSize   Int

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([homeworkId])
}

model HomeworkTarget {
  id         String     @id @default(uuid())
  homeworkId String
  targetType TargetType // CLASS | SECTION | STUDENT
  targetId   String // class_id, section_id, or student_id

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
  @@index([targetType, targetId])
}

model HomeworkSubmission {
  id         String           @id @default(uuid())
  homeworkId String
  studentId  String
  status     SubmissionStatus @default(PENDING)
  
  submittedAt DateTime?
  grade       String?
  feedback    String?
  gradedBy    String?
  gradedAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  student       Student  @relation(fields: [studentId], references: [student_id], onDelete: Cascade)
  gradedByTeacher Teacher? @relation("HomeworkGradedBy", fields: [gradedBy], references: [teacher_id])
  
  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
  @@index([status])
}


enum ExamStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum ExamTargetType {
  STUDENT
  SECTION
  SCHOOL
  CLASS
  GROUP
}

model Exam {
  id       String         @id @default(uuid())
  examType String // configurable exam type (e.g., "Mid-Term", "Final", "Unit Test")
  target   ExamTargetType // STUDENT | SECTION | SCHOOL
  status   ExamStatus     @default(DRAFT) // DRAFT | PUBLISHED | COMPLETED
  
  // Grading details (for the whole exam)
  gradingType String? // e.g., "Percentage", "Grade Points", "Pass/Fail"
  gradingExtras Json? // Additional grading configuration
  
  createdBy String // Teacher/Admin ID
  campusId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  subjects ExamSubject[]
  targets  ExamTarget[]
  grades   ExamGrade[]
  
  @@index([campusId])
  @@index([examType])
  @@index([target])
  @@index([status])
}

model ExamSubject {
  id            String   @id @default(uuid())
  examId        String
  subjectName   String
  examDate      DateTime @db.Date
  examStartTime String 
  examEndTime   String 
  
  extras Json? // Additional subject-specific details
  
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  grades ExamGrade[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([examId])
  @@index([examDate])
}

model ExamTarget {
  id         String         @id @default(uuid())
  examId     String
  targetType ExamTargetType // STUDENT | SECTION | SCHOOL
  targetId   String? // student_id, section_id, school_id (null for SCHOOL-level exams)
  
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  @@index([examId])
  @@index([targetType, targetId])
}

model ExamGrade {
  id              String   @id @default(uuid())
  examId          String
  examSubjectId   String
  studentId       String
  
  // Grading details
  gradesObtained  String?   // Actual marks scored
  remarks         String?  // Teacher's comments/feedback
  
  // Grading metadata
  gradedBy        String?  // Teacher ID who graded
  gradedAt        DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject    ExamSubject  @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [student_id], onDelete: Cascade)
  
  @@unique([examSubjectId, studentId]) // One grade per student per exam subject
  @@index([examId])
  @@index([examSubjectId])
  @@index([studentId])
  @@index([studentId, examId])
}

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ScholarshipStatus {
  OPEN
  CLOSED
  EXTENDED
  UPCOMING
}

model ChatConversation {
  id        String               @id @default(uuid())
  type      ChatConversationType
  title     String?
  campusId  String?
  /// For DIRECT chats: sorted `userIdA:userIdB` so the pair is unique
  directKey String?              @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([campusId])
  @@index([updatedAt])
}

model ChatParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String
  userRole       EndUserRole

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String @db.Text

  createdAt DateTime @default(now())

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  ChatMessageAttachment[]

  @@index([conversationId, createdAt])
}

model ChatMessageAttachment {
  id            String @id @default(uuid())
  chatMessageId String
  fileUrl       String
  fileName      String
  fileType      String
  fileSize      Int

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
}

model LessonPlan {
  id String @id @default(uuid())

  lessonDate          DateTime         @db.Date
  chapterTopic        String
  description         String?          @db.Text
  /// JSON array of strings, e.g. ["Understand X", "Apply Y"]
  learningObjectives  Json
  /// JSON array of { type, description?, duration_minutes? }
  activities          Json
  homework            String?          @db.Text
  status              LessonPlanStatus @default(PLANNED)

  subject String

  classId String
  classRef Class @relation(fields: [classId], references: [class_id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [section_id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [teacher_id])

  campusId String
  campus   Campus @relation(fields: [campusId], references: [campus_id])

  attachments LessonPlanAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, lessonDate])
  @@index([campusId, lessonDate])
  @@index([classId, sectionId])
  @@index([subject])
  @@index([status])
}

model LessonPlanAttachment {
  id           String @id @default(uuid())
  lessonPlanId String
  fileUrl      String
  fileName     String
  fileType     String
  fileSize     Int

  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lessonPlanId])
}

model MasterLessonPlan {
  id           String   @id @default(uuid())
  className    String
  subject      String
  board        String
  academicYear String
  /// JSON array of { chapter, topics[], month?, estimated_weeks? }
  details      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classPlans ClassPlan[]

  @@unique([className, subject, board, academicYear])
  @@index([className, subject, board])
  @@index([board])
  @@index([academicYear])
}

model ClassPlan {
  id           String  @id @default(uuid())
  masterPlanId String?
  masterPlan   MasterLessonPlan? @relation(fields: [masterPlanId], references: [id], onDelete: SetNull)

  campusId String
  campus   Campus @relation(fields: [campusId], references: [campus_id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [teacher_id])

  classId String
  classRef Class @relation(fields: [classId], references: [class_id])

  subject      String
  academicYear String
  isPublished  Boolean @default(false)

  topics ClassPlanTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, campusId, classId, subject, academicYear])
  @@index([campusId, academicYear])
  @@index([teacherId])
}

model ClassPlanTopic {
  id          String    @id @default(uuid())
  classPlanId String
  classPlan   ClassPlan @relation(fields: [classPlanId], references: [id], onDelete: Cascade)

  chapterTitle  String
  chapterNumber Int?
  title         String
  displayOrder  Float

  progress ClassPlanTopicProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classPlanId, chapterNumber, displayOrder])
}

model ClassPlanTopicProgress {
  id      String         @id @default(uuid())
  topicId String
  topic   ClassPlanTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [section_id])

  status             ClassPlanTopicStatus @default(PENDING)
  scheduledDate      DateTime?            @db.Date
  completedOn        DateTime?            @db.Date
  actualDurationMins Int?
  teacherNotes       String?              @db.Text
  isAddedByTeacher   Boolean              @default(false)

  materials   TopicMaterial[]
  assignments TopicAssignment[]
  quizzes     TopicQuiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, sectionId])
  @@index([topicId])
  @@index([sectionId])
}

model TopicMaterial {
  id         String                 @id @default(uuid())
  progressId String
  progress   ClassPlanTopicProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  fileName  String
  fileUrl   String

  createdAt DateTime @default(now())

  @@index([progressId])
}

model TopicAssignment {
  id         String                 @id @default(uuid())
  progressId String
  progress   ClassPlanTopicProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  title       String
  dueDate     DateTime?             @db.Date
  fileUrl     String?
  status      TopicAssignmentStatus @default(DRAFT)
  content     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([progressId])
}

model TopicQuiz {
  id         String                 @id @default(uuid())
  progressId String
  progress   ClassPlanTopicProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  title         String
  generatedByAi Boolean @default(false)
  fileUrl       String?
  content       Json?

  createdAt DateTime @default(now())

  @@index([progressId])
}

model Scholarship {
  id                 String            @id @default(uuid())
  sourceName         String
  sourceType         String
  scholarshipName    String
  category           String
  classes            Json
  targetGroup        Json
  academicYear       String
  status             ScholarshipStatus
  openDate           DateTime?         @db.Date
  closeDate          DateTime?         @db.Date
  benefitSummary     String?           @db.Text
  eligibilitySummary String?           @db.Text
  detailsUrl         String?
  announcementUrl    String?
  lastCheckedAt      DateTime?
  contentHash        String            @unique
  rawTitle           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYear])
  @@index([status])
  @@index([category])
  @@index([sourceType])
}

// ─── Pickup Feature ───────────────────────────────────────────────────────────

/// People pre-approved by parents to pick up a student (reusable)
model AuthorizedPickupPerson {
  id           String  @id @default(uuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [student_id], onDelete: Cascade)

  name         String
  relationship String  // e.g. "Uncle", "Grandmother", "Family Friend"
  photoUrl     String?
  remarks      String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupLogs PickupLog[]

  @@index([studentId])
  @@index([studentId, isActive])
}

/// One-time pickup request submitted by a parent for a specific date
model PickupRequest {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [student_id], onDelete: Cascade)

  // Person who will come to pick up
  name         String
  relationship String
  photoUrl     String?  // pre-submitted photo to verify identity at gate
  remarks      String?

  // Validity
  validDate DateTime @db.Date  // the date this request is valid for

  // Who raised the request
  requestedBy String  // free-form identifier (e.g. phone, name)

  // Approval workflow
  status        PickupRequestStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  rejectedBy    String?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupLog PickupLog?

  @@index([studentId, validDate])
  @@index([studentId, status])
  @@index([requestedBy])
  @@index([validDate, status])
}

// ─── Report Dashboard Config ────────────────────────────────────────────────

enum ReportConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ReportDashboardConfig {
  id          String             @id @default(uuid())
  name        String
  description String?
  campusId    String
  schoolLevel String
  useGrades   Boolean            @default(false)
  status      ReportConfigStatus @default(DRAFT)

  enabledClasses Json // array of class UUIDs
  skills         Json // array of skill objects
  ratingScale    Json // rating scale config (type, points, labels, emoji_set, etc.)
  display        Json // layout, charts, show_teacher_comments, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([campusId, status])
}

// ────────────────────────────────────────────────────────────────────────────

/// Teacher-confirmed record of a student being picked up
model CampusTierPermission {
  campus_id  String
  tier       String
  role       String   @default("") // 'student' | 'staff'
  feature_id String
  enabled    Boolean  @default(false)
  class_ids  String[] @default([])
  updated_at DateTime @default(now()) @updatedAt

  campus Campus @relation(fields: [campus_id], references: [campus_id], onDelete: Cascade)

  @@id([campus_id, tier, role, feature_id])
  @@index([campus_id, tier, role])
  @@index([campus_id])
}

model Admission {
  admission_id               String          @id @default(uuid())
  admission_application_no   String
  admission_academic_year    String
  admission_date             DateTime
  admission_applied_class_id String
  admission_status           AdmissionStatus @default(pending)
  admission_first_name       String
  admission_middle_name      String?
  admission_last_name        String?
  admission_gender           Gender
  admission_dob              DateTime

  extras Json?

  campus_id String
  campus    Campus @relation(fields: [campus_id], references: [campus_id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campus_id, admission_application_no])
  @@index([campus_id])
  @@index([admission_status])
}

model PickupLog {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [student_id], onDelete: Cascade)

  pickedUpAt  DateTime  // actual timestamp of pickup
  confirmedBy String    // teacher_id
  teacher     Teacher   @relation(fields: [confirmedBy], references: [teacher_id])

  pickupPhotoUrl String?  // optional photo taken at pickup time

  // Source of the pickup authorization
  source             PickupSource
  authorizedPersonId String?
  authorizedPerson   AuthorizedPickupPerson? @relation(fields: [authorizedPersonId], references: [id])
  pickupRequestId    String?                 @unique
  pickupRequest      PickupRequest?          @relation(fields: [pickupRequestId], references: [id])

  // Denormalized for audit trail — person details at time of pickup
  personName         String
  personRelationship String

  notes String?

  createdAt DateTime @default(now())

  @@index([studentId, pickedUpAt])
  @@index([confirmedBy])
  @@index([studentId])
}

// ─── Student Groups ───────────────────────────────────────────────────────────

model StudentGroup {
  id          String  @id @default(uuid())
  name        String
  description String?

  campusId String
  campus   Campus @relation(fields: [campusId], references: [campus_id], onDelete: Cascade)

  createdBy String
  teacher   Teacher @relation(fields: [createdBy], references: [teacher_id])

  members StudentGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId])
  @@index([createdBy])
}

model StudentGroupMember {
  groupId   String
  studentId String

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [student_id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([groupId, studentId])
  @@index([groupId])
  @@index([studentId])
}

// ─── PTM (Parent-Teacher Meeting) ────────────────────────────────────────────

/// A time slot a teacher makes available for parent meetings
model PtmSlot {
  id          String        @id @default(uuid())
  teacherId   String
  campusId    String
  title       String
  description String?       @db.Text
  date        DateTime      @db.Date
  startTime   String        // HH:MM
  endTime     String        // HH:MM
  capacity    Int           @default(1)   // max concurrent bookings for this slot
  status      PtmSlotStatus @default(AVAILABLE)
  createdBy   String        // teacher_id or admin userid

  teacher   Teacher      @relation(fields: [teacherId], references: [teacher_id])
  bookings  PtmBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, date])
  @@index([campusId, date, status])
  @@index([date, status])
}

/// A parent's booking of a PTM slot for their child
model PtmBooking {
  id           String           @id @default(uuid())
  ptmSlotId    String
  studentId    String
  parentId     String?          // parent_id from Parent model (optional — walk-in)
  status       PtmBookingStatus @default(SCHEDULED)
  teacherNotes String?          @db.Text // private; never sent to parent

  bookedAt    DateTime  @default(now())
  completedAt DateTime?

  ptmSlot PtmSlot @relation(fields: [ptmSlotId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [student_id])
  parent  Parent? @relation(fields: [parentId], references: [parent_id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ptmSlotId, studentId]) // one booking per student per slot
  @@index([ptmSlotId])
  @@index([studentId])
  @@index([parentId])
  @@index([status])
  @@index([studentId, status])
}
